# ═══════════════════════════════════════════════════════════════
# Trading Bot — Variables de Entorno
# Copia este archivo como .env y configura tus valores.
# ═══════════════════════════════════════════════════════════════

# ─── CREDENCIALES DE BINANCE ─────────────────────────────────
# API Key y Secret de tu cuenta de Binance.
# Genera las claves en: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=tu_binance_api_key
BINANCE_API_SECRET=tu_binance_api_secret

# ─── CREDENCIALES DE TELEGRAM ────────────────────────────────
# Token del bot de Telegram (obtenido de @BotFather).
TELEGRAM_BOT_TOKEN=tu_telegram_bot_token
# Chat ID donde se enviarán las notificaciones.
TELEGRAM_CHAT_ID=tu_chat_id

# ─── MODO DE EJECUCIÓN ──────────────────────────────────────
# true = simula órdenes sin ejecutarlas en Binance (seguro para pruebas).
DRY_RUN=true
# true = conectar al testnet de Binance en lugar de producción.
USE_TESTNET=false

# ─── NOTIFICACIONES ─────────────────────────────────────────
# true = habilitar notificaciones de Telegram.
NOTIFY_TELEGRAM_ENABLED=false
# Eventos que disparan notificación (valores: buy, sell, risk, withdraw).
# Ejemplo: "buy,sell" envía solo en compras y ventas.
NOTIFY_TELEGRAM_ON=buy,sell

# ─── PARÁMETROS DE TRADING ───────────────────────────────────
# Porcentaje de caída de precio para disparar una compra (default: 1).
BUY_PERCENT=1
# Porcentaje de ganancia neta objetivo por orden del grid (default: 2).
SELL_PERCENT=2
# Tasa de comisión de Binance (default: 0.001 = 0.1%).
FEE_RATE=0.001

# ─── GESTIÓN DE RIESGO ──────────────────────────────────────
# Stop-loss global del bot: porcentaje de pérdida para detener todo (default: 2).
STOP_LOSS_PERCENT=2
# Take-profit global del bot: porcentaje de ganancia para cerrar (default: 5).
TAKE_PROFIT_PERCENT=5
# Porcentaje máximo del balance que puede estar en órdenes abiertas (default: 5).
MAX_POSITION_PERCENT=5
# Porcentaje de drawdown que activa el kill-switch (default: 10).
DRAWDOWN_KILL_PERCENT=10

# ─── TRAILING TAKE-PROFIT ───────────────────────────────────
# Porcentaje de retroceso desde el pico para ejecutar venta (0 = deshabilitado).
TRAILING_TP_PERCENT=0

# ─── STOP-LOSS DE GRID ──────────────────────────────────────
# true = habilitar stop-loss individual por orden del grid.
GRID_STOP_LOSS_ENABLED=false
# Porcentaje de caída desde el precio de compra para activar SL de grid (default: 0.6).
GRID_STOP_LOSS_PERCENT=0.6
# true = evaluar SL en orden FIFO (primera compra primero). false = LIFO.
GRID_STOP_LOSS_FIFO=false

# ─── CICLO DE VIDA DEL BOT ──────────────────────────────────
# true = vender todo el saldo base al iniciar el bot.
SELL_ALL_ON_START=false
# true = vender todo al cerrar (por TP o SL global).
SELL_ALL_ON_CLOSE=false
# true = reiniciar el bot después de un retiro exitoso.
START_AGAIN=false

# ─── RETIROS ─────────────────────────────────────────────────
# true = habilitar retiros automáticos al alcanzar take-profit.
WITHDRAW_PROFITS_ENABLED=false
# Ganancia mínima requerida para ejecutar un retiro (en moneda de cotización).
MIN_WITHDRAW_AMOUNT=0
# Red de blockchain para retiros (ejemplo: BSC, ETH, TRX).
DEFAULT_WITHDRAW_NETWORK=
# Dirección de retiro para BUSD.
WITHDRAW_ADDRESS_BUSD=
# Dirección de retiro para USDT.
WITHDRAW_ADDRESS_USDT=

# ─── RENDIMIENTO ─────────────────────────────────────────────
# Intervalo entre ciclos del bot en milisegundos (default: 10000 = 10s, mínimo: 1000).
POLL_INTERVAL_MS=10000
