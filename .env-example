## Si el precio baja 0.2% comprar
BUY_PERCENT=0.2

## Si el precio sube 0.4% vender (Neto tras comisiones)
SELL_PERCENT=0.4

## Comision por operacion Spot Binance (0.001 = 0.1%, 0.00075 con BNB)
FEE_RATE=0.001

## APIKEY de binance
APIKEY=

## Secret key de binance
SECRET=

SLEEP_TIME=10000

## ===== FLAGS DE PRODUCCION =====

## Modo Dry-Run: calcula todo pero NO ejecuta ordenes reales en Binance
## Util para validar la estrategia sin arriesgar fondos
DRY_RUN=false

## Testnet: apunta todas las llamadas API a testnet.binance.vision
## Usa fondos ficticios para probar payloads y respuestas
USE_TESTNET=false

## Limite de posicion: maximo % del balance que se puede comprometer en una sola orden
## Ej: 5 = nunca mas del 5% del saldo disponible por compra
MAX_POSITION_PERCENT=5

## Kill-switch de drawdown: si el balance cae este % en 24 horas, detiene toda operacion
## Requiere intervencion manual para reanudar
DRAWDOWN_KILL_PERCENT=10

## ===== ESTRATEGIA DE GRID =====

## Trailing Take-Profit: % de retroceso desde el pico para ejecutar la venta
## 0 = desactivado (venta estatica al tocar sell_price, comportamiento original)
## Ej: 0.15 = espera a que el precio retroceda 0.15% desde su maximo para vender
TRAILING_TP_PERCENT=0

## Porcentaje de ganancias 15 es el 15%
TAKE_PROFIT_BOT=15

## Porcentaje de perdidas 30 es el 30%
STOP_LOSS_BOT=30

## Bandera que indica que el bot debe cerrar todas sus ordenes
## al llegar a la meta de ganancias o perdidas.
SELL_ALL_ON_CLOSE=false

## Bandera que indica que el bot debe iniciar limpiando todo si
## se detuvo de forma inesperada
SELL_ALL_ON_START=true

## Vende en perdidas para poder seguir operando funcion experimental
## 0.6 es el 0.6% de perdida, si esta vacio no se usa
USE_STOP_LOSS_GRID=
STOP_LOSS_GRID=0.6
STOP_LOSS_GRID_IS_FIFO=1

## ===== RETIROS =====

## Bandera para retirar de binance a una wallet externa
## si esta vacia queda en binance y no pasa nada.
WITHDRAW_PROFITS=
MIN_WITHDRAW_AMOUNT=10
# AVAILABLE NETWORKS FOR BUSD: BSC, ETH, MATIC, AVAXC
# AVAILABLE NETWORKS FOR USDT: BSC, ETH, TRX, SOL, MATIC, AVAXC, EOS
DEFAULT_WITHDRAW_NETWORK=BSC
WITHDRAW_ADDRESS_BUSD=
WITHDRAW_ADDRESS_USDT=
START_AGAIN=

## ===== NOTIFICACIONES TELEGRAM =====

## Bandera para enviar notificaciones en telegram, si esta vacia no se activa
NOTIFY_TELEGRAM=
NOTIFY_TELEGRAM_ON=sell,buy,withdraw
TELEGRAM_BOT_ID=
TELEGRAM_CHAT_ID=